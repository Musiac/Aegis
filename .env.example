# Copy this file to .env and fill in an LLM key for whichever provider you pick in the model dropdown.
# Leave REDTEAM_TOKEN / PENTESTLIVE_TOKEN alone -- install.sh generates and appends them to .env itself
# on first run if they are not already present.

# --- LLM key: this is a Muse-Spark-only build (Meta Global Hackathon fork of Aegis) -- MUSE_API_KEY is the
# one that matters. GOOGLE_API_KEY/ANTHROPIC_API_KEY stay usable via AEGIS_PROVIDER/the auto-route vars below
# even though "gemini"/"claude" aren't in the dropdown; "local"/"gpt" don't exist in this build at all.
MUSE_API_KEY=
MUSE_MODEL=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional, personal choice (never required): route plain scan/pentest requests to one provider and
# fix/remediate requests to another, automatically, based on each message's own wording. Leave BOTH unset for
# today's default (one provider, picked by the model dropdown/AEGIS_PROVIDER, for the whole session).
AEGIS_SCAN_PROVIDER=
AEGIS_FIX_PROVIDER=

# --- Optional: only needed to clone a PRIVATE GitHub repo as a target (a public repo clones with no token at all) ---
GITHUB_CLONE_TOKEN=

# --- Generated by install.sh on first run -- do not set these by hand ---
# REDTEAM_TOKEN=
# PENTESTLIVE_TOKEN=
